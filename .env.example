WIFI_SSID=YourWifiName
WIFI_PASS=YourWifiPassword
BMS_BLE_ADDRESS=AA:BB:CC:DD:EE:FF

# Optional EcoFlow DELTA 3 bridge (ESP32-S3 COM8) — set as Windows User env (never commit real values):
# ECOFLOW_BLE_ADDRESS=AA:BB:CC:DD:EE:FF   # BLE MAC next to advertise name EF-D3…
# ECOFLOW_SERIAL=PXXXXXXXXXXW0000         # device SN from label / barcode
# ECOFLOW_USER_ID=1234567890123456789     # account userId / cookie ef_uid (not the JWT)

# Optional XT369P solar bridge (ESP-NOW) - prefer the pairing script (reads both MACs):
#   .\scripts\pair_espnow_link.ps1 -HubPort COM19 -BridgePort COM22 -Flash
#
# Manual map (HUB = this Wattcycle board, BRIDGE = XT369P):
#   ESPNOW_BRIDGE_MAC = BRIDGE (XT369P) STA MAC   <- not this board's MAC
#   ESPNOW_PEER_MAC   = HUB (this) STA MAC         <- set on the XT369P repo
#   ESPNOW_PMK        = same 32-char hex on both
# ESPNOW_BRIDGE_MAC=
# ESPNOW_PMK=
